{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "蒜狸小助手",
  "mainBinaryName": "蒜狸小助手",
  "version": "3.0.12",
  "identifier": "com.ovaijisuan.design",
  "build": {
    "frontendDist": "../canvas-web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "个人学习研究项目",
    "category": "DeveloperTool",
    "shortDescription": "接自建 MaaS 平台的画布 + agent",
    "resources": {
      "../canvas-web/dist": "web",
      "../../mcp/dist/main.js": "mcp/main.js",
      "../../assets/skills": "skills"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
