  {
   "name": "task_query",
   "description": "Read authorized project tasks: mode=get requires taskId and returns {task,input}; mode=list returns {items,nextCursor,coverage} filtered by query.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "mode": {
      "type": "string",
      "enum": [
       "get",
       "list"
      ],
      "description": "get 需要 taskId；list 走 query 过滤"
     },
     "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "mode=get 时必填"
     },
     "query": {
      "type": "object",
      "properties": {
       "status": {
        "type": "array",
        "items": {
         "type": "string",
         "enum": [
          "accepted",
          "running",
          "waiting_user",
          "unknown",
          "completed",
          "failed",
          "cancelled"
         ]
        },
        "minItems": 1,
        "maxItems": 7
       },
       "operation": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "description": "mode=list 时的过滤条件"
     }
    },
    "required": [
     "mode"
    ],
    "additionalProperties": true,
    "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "execution": {
    "taskSupport": "forbidden"
   }
  },
  {
   "name": "task_resolve",
   "description": "Apply task actions with the latest task.revision as expectedRevision; returns {task}. On revision conflict the call fails and the task must be re-read.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
     },
     "expectedRevision": {
      "type": "integer",
      "minimum": 1
     },
     "action": {
      "type": "string",
      "enum": [
       "pause",
       "resume",
       "stop",
       "adopt_version",
       "finish_as_candidate",
       "update_placement",
       "finish_without_placement",
       "retry"
      ]
     },
     "expectedCurrentVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
     }
    },
    "required": [
     "taskId",
     "expectedRevision",
     "action"
    ],
    "additionalProperties": true,
    "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "execution": {
    "taskSupport": "forbidden"
   }
  },
