{
  "name": "@ov/memory-store",
  "version": "0.0.0",
  "private": true,
  "description": "记忆的文件存储：<projectRoot>/.hilo/memory/*.md + 用户级记忆 + MEMORY.md 索引。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  }
}
