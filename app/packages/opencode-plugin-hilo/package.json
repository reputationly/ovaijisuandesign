{
  "name": "@ov/opencode-plugin-hilo",
  "version": "0.0.0",
  "private": true,
  "description": "opencode 插件：工作语言、记忆上下文、防打转、工具确认、技能授权、question 选项校验、给 hub 工具注入会话参数等。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@types/js-yaml": "4.0.9",
    "esbuild": "^0.28.2",
    "js-yaml": "4.3.2"
  }
}
