{
  "name": "@ov/mcp-tools",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server（server 名 hub）。registrar + GatewayClient + runAsync，见 docs/mcp-tools-architecture.md。由 opencode 以 Electron-as-Node 拉起。",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./subtitle-format": {
      "types": "./dist/tools/subtitle-format.d.ts",
      "import": "./dist/tools/subtitle-format.js"
    }
  },
  "bin": {
    "ov-mcp-tools": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@ov/protocol": "workspace:^",
    "js-yaml": "4.3.2",
    "proper-lockfile": "4.1.2",
    "undici": "7.29.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/proper-lockfile": "4.1.4"
  }
}
