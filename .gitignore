target/
node_modules/
dist/
*.log
.DS_Store

# 本地配置（含 api_key）
config.local.json
config.json

# 对照用的参照原文。按版本号放的快照（reference/<版本>/）进版本库，供云端对照；
# 其余本地探测产物（截图、清单、运行时快照）不进。
reference/*
!reference/README.md
!reference/3.0.16/
# 参照的 gateway / mcp-tools / 插件原文就在各自的 dist/ 里，别被上面通用的 dist/ 规则吞掉。
!reference/3.0.16/**/dist/

# 探测脚本、截图之类的临时产物
.probe/

# python 字节码
__pycache__/
*.pyc

# mcp 的打包产物（由 release.py / tauri 打包时生成）
mcp/dist/

# 新栈（pnpm + turbo）
.turbo/
app/desktop/out/

# Claude Code 的本地设置与 worktree
.claude/settings.local.json
.claude/worktrees/
