target/
node_modules/
dist/
*.log
.DS_Store

# 本地配置（含 api_key）
config.local.json
config.json

# 对照用的参照原文。按版本号放的快照（reference/<版本>/）进版本库，供云端对照；
# 其余本地探测产物（截图、清单、运行时快照）不进。
reference/*
!reference/README.md
!reference/3.0.16/
# 参照的 gateway / mcp-tools / 插件原文就在各自的 dist/ 里，别被上面通用的 dist/ 规则吞掉。
!reference/3.0.16/**/dist/
!reference/3.0.20/
!reference/3.0.20/**/dist/
!reference/3.0.21/
!reference/3.0.21/**/dist/

# 探测脚本、截图之类的临时产物
.probe/

# python 字节码
__pycache__/
*.pyc

# mcp 的打包产物（由 release.py / tauri 打包时生成）
mcp/dist/

# gateway 的工作区私有目录（缩略图缓存、首页示例图预热缓存、生成账本…）。
# 跑测试时会在 app/gateway/ 下生成一份，别进版本库。
**/.hilo/

# agent runtime（opencode 1.18.18，142MB 二进制）。由 scripts/fetch-opencode.mjs 下载，
# 仓库只留脚本不留二进制 —— 和上面 assets/home-showcase/media/ 同一个理由。
app/packages/service/bin/

# 新栈（pnpm + turbo）
.turbo/
app/desktop/out/

# Claude Code 的本地设置与 worktree
.claude/settings.local.json
.claude/worktrees/

# 体积大的自带模板（75MB）放本地可用，但不进仓库
assets/project-templates/h3-playground.zip

# 首页「创作灵感」图片素材（~665MB，用 scripts/fetch-home-showcase-images.py 下载）
assets/home-showcase/media/

# 新栈打包产物（electron-builder 的输出目录，几百 MB）
app/desktop/dist-electron/
app/desktop/build-resources/
